Algoritmo FacturaRestaurante
    Definir precio, subtotal, impuesto, propina, total Como Real
	
    subtotal <- 0
	
    Escribir "Ingresa el valor del plato (0 para terminar):"
    Leer precio
	
    Mientras precio <> 0 Hacer
        subtotal <- subtotal + precio
		
        Escribir "Ingresa el valor del siguiente plato (0 para terminar):"
        Leer precio
    FinMientras
	
    impuesto <- subtotal * 0.08
    propina <- subtotal * 0.10
    total <- subtotal + impuesto + propina
	
    Escribir "Subtotal: $", subtotal
    Escribir "Impuesto: $", impuesto
    Escribir "Propina: $", propina
    Escribir "Total: $", total

	
FinAlgoritmo